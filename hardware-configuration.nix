# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
#
# Türkçesi: Bu dosyayı kurulumda nixos-generate-config üretti; donanımı tarar ve buraya yazar.
# Ayar buraya eklenmez, configuration.nix'e eklenir (örneğin btrfs sıkıştırması orada; NixOS ikisini
# birleştirir). Komut yeniden çalıştırılırsa dosya baştan yazılır ve aşağıdaki Türkçe açıklamalar
# gider; ayarlar etkilenmez. configuration.nix bu dosyayı "imports" ile okur.
{ config, lib, pkgs, modulesPath, ... }:

{
  # not-detected.nix: tek satırlık bir NixOS modülü; hardware.enableRedistributableFirmware'ı açar.
  # Kapalı kaynak ama dağıtılabilen firmware'ler kurulur: Wi-Fi, Bluetooth, ekran kartları ve
  # aşağıdaki işlemci mikrokodu bunlara bağlı.
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  # initrd: çekirdekle birlikte yüklenen küçük geçici sistem; asıl diski bulup bağlar, sonra asıl
  # sisteme geçer. Diski görebilmesi için gereken modüller:
  #   nvme (NVMe SSD), ahci + sd_mod (SATA disk), xhci_pci + usbhid + usb_storage (USB klavye, USB disk)
  boot.initrd.availableKernelModules = [ "xhci_pci" "nvme" "ahci" "usbhid" "usb_storage" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  # Açılıştan sonra yüklenen modüller. kvm-amd: sanal makineler (AMD işlemcinin sanallaştırma desteği).
  boot.kernelModules = [ "kvm-amd" ];
  # Çekirdeğin dışından gelen ek modüller (Nvidia'nınki configuration.nix'teki hardware.nvidia'dan gelir).
  boot.extraModulePackages = [ ];

  # Ana bölüm: üç satırda da aynı UUID, yani aynı btrfs bölümü; "subvol=" hangi alt birimin
  # bağlanacağını seçer. Sıkıştırma ve noatime configuration.nix'te eklenir.
  fileSystems."/" =
    { device = "/dev/disk/by-uuid/a27b8c02-9014-4acb-b726-b462183465f9";
      fsType = "btrfs";
      options = [ "subvol=@" ];
    };

  fileSystems."/home" =
    { device = "/dev/disk/by-uuid/a27b8c02-9014-4acb-b726-b462183465f9";
      fsType = "btrfs";
      options = [ "subvol=@home" ];
    };

  fileSystems."/nix" =
    { device = "/dev/disk/by-uuid/a27b8c02-9014-4acb-b726-b462183465f9";
      fsType = "btrfs";
      options = [ "subvol=@nix" ];
    };

  # EFI bölümü: systemd-boot, çekirdekler ve initrd'ler burada. fmask/dmask=0077: içindeki
  # dosyaları yalnızca root okuyabilir.
  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/4AFA-B533";
      fsType = "vfat";
      options = [ "fmask=0077" "dmask=0077" ];
    };

  # Diskte takas bölümü yok; takas RAM'de (configuration.nix → zramSwap).
  swapDevices = [ ];

  # İşlemci mimarisi; flake.nix sistemi buna göre kurar.
  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  # AMD işlemci mikrokodu: açılışta işlemcinin hatalarını düzelten güncellemeler yüklenir
  # (firmware yukarıda açık olduğu için açık).
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
